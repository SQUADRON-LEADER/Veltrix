##############################################################################
# Veltrix Frontend — .dockerignore
# Author: Aayush | Module 1: Docker & Containerization
##############################################################################

# Node dependencies
node_modules/
npm-debug.log*

# Previous build output (Docker rebuilds this fresh)
dist/

# Environment secrets
.env
.env.*
!.env.example

# Git internals
.git/
.gitignore
.gitattributes

# Editor / OS junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker files
Dockerfile
Dockerfile.*
.dockerignore

# Docs & config files not needed in image
*.md
README.md
