##############################################################################
# Veltrix Backend — .dockerignore
# Author: Aayush | Module 1: Docker & Containerization
# Prevents unnecessary files from being sent to Docker build context.
# Smaller context = faster builds in Jenkins.
##############################################################################

# Node dependencies (installed fresh inside Docker)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment secrets — NEVER include in image
.env
.env.*
!.env.example

# Git internals
.git/
.gitignore
.gitattributes
.github/

# Veltrix local repo data
.veltrix/

# Test artifacts (not needed at runtime)
tests/
coverage/
__tests__/
*.test.js
*.spec.js
jest.config.*

# Logs
logs/
*.log

# Editor / OS junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker files themselves
Dockerfile
Dockerfile.*
.dockerignore

# Docs
*.md
docs/
